generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}
 
datasource db {
  provider = "sqlite"
}
 
model Evento {
  id        Int      @id @default(autoincrement()) @map("id_evento")
  nome      String  
  descricao String  
  local     String  
        
  palestrantes EventoPalestrante[]
  @@map("evento")
}
 
model Palestrante {
  id    Int    @id @default(autoincrement()) @map("id_palestrante")
  nome  String
  email String @unique
  eventos EventoPalestrante[]
  @@map("palestrante")
}
 
model EventoPalestrante {
  eventoId      Int @map("id_evento")
  palestranteId Int @map("id_palestrante")
  evento      Evento      @relation(fields: [eventoId], references: [id])
  palestrante Palestrante @relation(fields: [palestranteId], references: [id])
  @@id([eventoId, palestranteId])
  @@map("evento_palestrante")
}